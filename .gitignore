.env.local
.env.*.local

# Bağımlılıklar
node_modules/

# Build çıktıları
dist/
dist-ssr/
build/

# Log dosyaları
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Geçici dosyalar
*.local
analyze.txt

# OS dosyaları
.DS_Store
Thumbs.db
desktop.ini

# Editor dosyaları
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Model cache (@xenova/transformers büyük dosyalar)
.cache/
