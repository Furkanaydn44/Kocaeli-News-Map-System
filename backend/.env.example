# MongoDB bağlantı URI'si
# Örnek: mongodb+srv://KULLANICI:SIFRE@cluster.mongodb.net/?appName=AppAdi
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=MyApp

# Google Maps API Anahtarı
# https://console.cloud.google.com adresinden alınabilir
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Sunucu portu (varsayılan: 5000)
PORT=5000
